# Copy this file to .env and fill in the values. Never commit .env.

# Same database as apps/web
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.b5hk5x6.mongodb.net/piq?retryWrites=true&w=majority&appName=Cluster0"

# LLM is only used to turn free text into symptom codes. Leave the key empty for rule-only.
# Gemini's free tier may use and human-review what you send: mock data only, never real patient text.
LLM_API_KEY=
# 3.6 Flash and newer ignore temperature, which SPEC.md §4.1 sets to 0
LLM_MODEL=gemini-3.5-flash-lite

# Optional: aging parameters (SPEC.md §5). Defaults are B = {2:1000,3:600,4:300,5:200}, alpha = 2.0
# QUEUE_BASE_SCORES={"2":1000,"3":600,"4":300,"5":200}
# QUEUE_ALPHA=2.0
