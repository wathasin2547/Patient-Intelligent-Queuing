# Copy this file to .env and fill in the values. Never commit .env.

# Same database as apps/web
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.b5hk5x6.mongodb.net/piq?retryWrites=true&w=majority&appName=Cluster0"

# LLM is only used to turn free text into symptom codes (phase 5)
LLM_API_KEY=
LLM_MODEL=

