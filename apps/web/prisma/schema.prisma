// Collection and field names must match SPEC.md §2 and the ER diagram in the thesis.
// Changing a name here means updating the report too.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  lineUserId     String   @unique
  fullName       String?
  ageGroup       String? // "0-5" | "6-17" | "18-59" | "60+"
  gender         String?
  healthCoverage String?
  isChronic      Boolean  @default(false)
  address        String?
  createdAt      DateTime @default(now())

  screenings   Screening[]
  refills      RefillSchedule[]
  queues       Queue[]
  appointments Appointment[]
}

model SymptomCode {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  code              String   @unique // "abdominal_pain_rlq"
  label             String // "ปวดท้องด้านขวาล่าง"
  synonyms          String[] // words patients tend to use; helps the LLM
  departmentWeights Json // { "<departmentId>": number }
  isRedFlag         Boolean  @default(false)
  onsiteOnly        Boolean  @default(false)
  priorityHint      Int? // 1-5, minimum level forced by this code
  isActive          Boolean  @default(true)
}

model Question {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  questionText String
  options      Json // [{ label, symptomCode }]
  group        String // "basic" | "redflag" | "chief" | "chronic"
  order        Int
  dependsOn    Json? // condition for showing this question
  isActive     Boolean @default(true)
}

model Screening {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId          String   @db.ObjectId
  answers            Json // raw closed-ended answers
  freeTextInput      String?
  symptomCodes       String[] // merged codes from both sources
  llmCodes           String[] // codes that came from the LLM only (for auditing)
  llmStatus          String // "ok" | "skipped" | "failed"
  departmentScores   Json // { "<departmentId>": number }
  assignedDepartment String?  @db.ObjectId
  priorityLevel      Int // 1-5
  onlineEligible     Boolean  @default(false)
  isRedFlag          Boolean  @default(false)
  reason             Json // which codes drove the decision
  createdAt          DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  queues  Queue[] // more than one when the patient is referred on the same day
}

model Department {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String  @unique
  code                  String?
  scopeOfCare           String?
  defaultServiceMinutes Int     @default(10) // ETA fallback until the doctor has finished cases today
  isActive              Boolean @default(true)

  doctors Doctor[]
  queues  Queue[]
}

model Doctor {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  departmentId String  @db.ObjectId
  meetingUrl   String? // fixed room on an external video service for online visits

  department   Department    @relation(fields: [departmentId], references: [id])
  shifts       Shift[]
  queues       Queue[]
  appointments Appointment[]
}

// Appointment queues recorded by staff (UC11); patients cannot book by themselves
model Appointment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  doctorId        String   @db.ObjectId
  appointmentTime DateTime
  reason          String
  status          String   @default("SCHEDULED") // SCHEDULED | ARRIVED | CANCELLED | MISSED
  createdBy       String   @db.ObjectId // User who recorded it
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  queues  Queue[]
}

model Shift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String   @db.ObjectId
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    String   @default("ACTIVE") // ACTIVE | CANCELLED

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model Queue {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId           String    @db.ObjectId // read by the algorithm service (one call at a time per patient)
  screeningId         String    @db.ObjectId // not unique: a same-day referral reuses the screening
  appointmentId       String?   @db.ObjectId // set when the queue comes from a checked-in appointment
  departmentId        String    @db.ObjectId
  doctorId            String?   @db.ObjectId
  queueNumber         String // "MED-014"
  visitType           String // "ONSITE" | "ONLINE"
  priorityLevel       Int // copied from screening (staff may edit)
  status              String    @default("WAITING") // WAITING | CALLED | IN_PROGRESS | DONE | NO_SHOW | CANCELLED
  checkInTime         DateTime  @default(now())
  calledTime          DateTime?
  finishedTime        DateTime?
  editedBy            String?   @db.ObjectId
  editedAt            DateTime?
  referredFromQueueId String?   @db.ObjectId // same-day referral from another department

  patient      Patient       @relation(fields: [patientId], references: [id])
  screening    Screening     @relation(fields: [screeningId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  prescription Prescription?
}

model Prescription {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  queueId    String   @unique @db.ObjectId
  items      Json // [{ name, dosage, quantity }]
  daysSupply Int
  issuedAt   DateTime @default(now())

  queue    Queue            @relation(fields: [queueId], references: [id])
  delivery Delivery?
  refills  RefillSchedule[]
}

model Delivery {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  prescriptionId String   @unique @db.ObjectId
  method         String // "PICKUP" | "SHIP"
  address        String?
  status         String   @default("PENDING") // PENDING | PREPARING | READY | SHIPPED | COMPLETED
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
}

model RefillSchedule {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String    @db.ObjectId
  prescriptionId String    @db.ObjectId
  dueDate        DateTime
  remindedAt     DateTime?
  status         String    @default("PENDING") // PENDING | SENT | CLOSED

  patient      Patient      @relation(fields: [patientId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
}

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  username     String  @unique
  passwordHash String
  role         String // STAFF | ADMIN | DOCTOR
  departmentId String? @db.ObjectId
  doctorId     String? @db.ObjectId // DOCTOR accounts only
  isActive     Boolean @default(true)
}

// Admin-editable system settings (single document), kept out of code like the screening criteria
model SystemSetting {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  maxActiveQueues     Int      @default(3) // queues one patient may hold at once, one per department
  // D_j in P = B[L] + alpha * (W + D): head start in minutes for patients at higher risk while waiting
  ageBonusMinutes     Int      @default(30)
  chronicBonusMinutes Int      @default(15)
  priorityAgeGroups   String[] @default(["60+"]) // Patient.ageGroup values that get ageBonusMinutes
}
