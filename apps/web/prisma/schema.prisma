generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  lineUserId     String   @unique
  fullName       String?
  age            Int?
  ageGroup       String?
  gender         String?
  healthCoverage String?
  isChronic      Boolean  @default(false)
  address        String?
  phoneNumber    String?
  nationalId     String?
  hn             String?
  createdAt      DateTime @default(now())

  screenings   Screening[]
  refills      RefillSchedule[]
  queues       Queue[]
  appointments Appointment[]
}

model SymptomCode {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  code              String   @unique
  label             String
  synonyms          String[]
  departmentWeights Json
  isRedFlag         Boolean  @default(false)
  onsiteOnly        Boolean  @default(false)
  priorityHint      Int?
  isActive          Boolean  @default(true)
}

model Question {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  questionText String
  options      Json
  group        String
  order        Int
  dependsOn    Json?
  isActive     Boolean @default(true)
}

model Screening {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId          String   @db.ObjectId
  answers            Json
  freeTextInput      String?
  symptomCodes       String[]
  llmCodes           String[]
  llmStatus          String
  departmentScores   Json
  assignedDepartment String?  @db.ObjectId
  priorityLevel      Int
  onlineEligible     Boolean  @default(false)
  isRedFlag          Boolean  @default(false)
  reason             Json
  createdAt          DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  queues  Queue[]
}

model Department {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  name                  String  @unique
  code                  String?
  scopeOfCare           String?
  defaultServiceMinutes Int     @default(10)
  isActive              Boolean @default(true)

  doctors Doctor[]
  queues  Queue[]
}

model Doctor {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  departmentId String  @db.ObjectId
  meetingUrl   String?

  department   Department    @relation(fields: [departmentId], references: [id])
  shifts       Shift[]
  queues       Queue[]
  appointments Appointment[]
}

model Appointment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String   @db.ObjectId
  doctorId        String   @db.ObjectId
  appointmentTime DateTime
  reason          String
  status          String   @default("SCHEDULED")
  createdBy       String   @db.ObjectId
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  queues  Queue[]
}

model Shift {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String   @db.ObjectId
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    String   @default("ACTIVE")

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model Queue {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId           String    @db.ObjectId
  screeningId         String?   @db.ObjectId
  appointmentId       String?   @db.ObjectId
  departmentId        String    @db.ObjectId
  doctorId            String?   @db.ObjectId
  queueNumber         String
  visitType           String
  priorityLevel       Int
  status              String    @default("WAITING")
  checkInTime         DateTime  @default(now())
  calledTime          DateTime?
  finishedTime        DateTime?
  editedBy            String?   @db.ObjectId
  editedAt            DateTime?
  referredFromQueueId String?   @db.ObjectId

  patient      Patient       @relation(fields: [patientId], references: [id])
  screening    Screening?    @relation(fields: [screeningId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  prescription Prescription?
}

model Prescription {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  queueId    String   @unique @db.ObjectId
  items      Json
  daysSupply Int
  issuedAt   DateTime @default(now())

  queue    Queue            @relation(fields: [queueId], references: [id])
  delivery Delivery?
  refills  RefillSchedule[]
}

model Delivery {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  prescriptionId String   @unique @db.ObjectId
  method         String
  address        String?
  status         String   @default("PENDING")
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
}

model RefillSchedule {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String    @db.ObjectId
  prescriptionId String    @db.ObjectId
  dueDate        DateTime
  remindedAt     DateTime?
  status         String    @default("PENDING")

  patient      Patient      @relation(fields: [patientId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
}

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  username     String  @unique
  passwordHash String
  role         String
  departmentId String? @db.ObjectId
  doctorId     String? @db.ObjectId
  isActive     Boolean @default(true)
}

model SystemSetting {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  maxActiveQueues     Int      @default(3)

  ageBonusMinutes     Int      @default(30)
  chronicBonusMinutes Int      @default(15)
  priorityAgeGroups   String[] @default(["60+"])
}
