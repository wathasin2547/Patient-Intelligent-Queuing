# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas — note the database name "piq" after .mongodb.net/
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.b5hk5x6.mongodb.net/piq?retryWrites=true&w=majority&appName=Cluster0"

# npm run db:seed wipes the database it points at, and needs SEED_ALLOW_RESET=yes
# Use your own database name while developing, for example .mongodb.net/piq_yourname
# npm run db:sync only adds what is missing and renews 7 days of shifts: safe on a shared database
# SEED_ALLOW_RESET=yes

# real = /staff, /liff and /display use MongoDB. Leave empty for the mock data in the browser
NEXT_PUBLIC_DATA_MODE=
NEXT_PUBLIC_LIFF_ID=

# Passwords for the mock accounts created by `npm run db:seed`
# (usernames: admin / staff.med / doc.med1 / staff.old — the last one is suspended). Development only.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
# optional, doc.med1 uses SEED_STAFF_PASSWORD when empty
SEED_DOCTOR_PASSWORD=

# Signs the login session cookie (NextAuth). Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# Filled in later phases
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
ALGORITHM_SERVICE_URL=http://localhost:8000
